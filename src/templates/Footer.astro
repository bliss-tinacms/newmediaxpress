---
import { tinaField } from "tinacms/dist/react";
interface Props { config?: any; navigation?: any; editData?: any; }
const { config = {}, navigation = {}, editData } = Astro.props;
const logo = config?.seo?.footerLogo || config?.seo?.logo || "/images/newmediaxpress/a0ac5c71a06a9c052d01c6bcff145d8a8523dfc65afeb39dba239bd44db60b90.png";
const links = navigation?.items || [];
const year = new Date().getFullYear();
---
<footer class="nx-footer">
  <div class="nx-shell nx-footer__inner">
    <div class="nx-footer__top">
      <a href="/" class="nx-footer__logo"><img src={logo} alt={config?.seo?.title || "New Media Xpress"} /></a>
      <nav class="nx-footer__nav" aria-label="Footer navigation" data-tina-field={editData ? tinaField(editData, "footerNavigation") : undefined}>
        {links.map((item: any) => <a href={item.href || item.link || "#"}>{item.label || item.title}</a>)}
      </nav>
    </div>
    <div class="nx-footer__rule"></div>
    <div class="nx-footer__bottom">
      <p>© {year} {config?.seo?.title}. {config?.globalText?.copyrightSuffix}</p>
      <p>{config?.globalText?.footerTagline}</p>
    </div>
  </div>
</footer>
