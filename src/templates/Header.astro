---
import { tinaField } from "tinacms/dist/react";
interface Props { config?: any; navigation?: any; editData?: any; }
const { config = {}, navigation = {}, editData } = Astro.props;
const logo = config?.seo?.logo || "/images/newmediaxpress/a0ac5c71a06a9c052d01c6bcff145d8a8523dfc65afeb39dba239bd44db60b90.png";
const links = navigation?.items || [];
---
<header class="nx-header">
  <div class="nx-shell nx-header__inner">
    <a class="nx-logo" href="/" aria-label={config?.seo?.title || "New Media Xpress"} data-tina-field={editData ? tinaField(editData, "seo.logo") : undefined}>
      <img src={logo} alt={config?.seo?.title || "New Media Xpress"} />
    </a>
    <nav class="nx-nav" aria-label="Primary navigation" data-tina-field={editData ? tinaField(editData, "headerNavigation") : undefined}>
      {links.map((item: any) => <a href={item.href || item.link || "#"}>{item.label || item.title}</a>)}
    </nav>
  </div>
</header>
