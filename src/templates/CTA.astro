---
interface Props { heading?: string; buttonText?: string; buttonLink?: string; }
import { getConfig } from "../lib/data";
const configResult = await getConfig().catch(() => ({} as any));
const globalText = (configResult as any)?.data?.config?.globalText || {};
const { heading = globalText.ctaHeading, buttonText = globalText.ctaButtonText, buttonLink = globalText.ctaButtonLink } = Astro.props;
---
<section class="nx-cta">
  <div class="nx-shell nx-cta__inner">
    <h2>{heading}</h2>
    <a class="nx-button nx-button--ink" href={buttonLink}>{buttonText} <span aria-hidden="true">→</span></a>
  </div>
</section>
