---
import Base from '../layouts/Base.astro';
import Demo404 from '../components/demo/Demo404.astro';
import { getConfig } from '../lib/data';

const config = (await getConfig()).data?.config;
const content = config?.systemPages?.notFound;
const title = content?.metaTitle;
const description = content?.metaDescription;
---

<Base title={title} description={description} noindex={true}>
  <Demo404 content={content} />
</Base>
