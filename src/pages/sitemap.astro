---
import Base from '../layouts/Base.astro';
import CTA from '../templates/CTA.astro';
import { getConfig, listBlogs, listPages } from '../lib/data';
import { getBlogPermalink, getPageRouteSlug } from '../lib/permalinks';

export const prerender = false;

const pages = await listPages();
const posts = await listBlogs();
const config = (await getConfig()).data?.config;
const content = config?.systemPages?.sitemap;
const title = content?.metaTitle;
const description = content?.metaDescription;

function cleanTitle(value: unknown, fallback: string) {
  return typeof value === 'string' && value.trim() ? value.trim() : fallback;
}
function withTrailingSlash(value: string) {
  if (!value || value === '/') return '/';
  const normalized = value.startsWith('/') ? value : '/' + value;
  return normalized.endsWith('/') ? normalized : normalized + '/';
}
function pageUrl(page: any) {
  const filename = page?._sys?.filename || '';
  if (filename === 'home') return '/';
  return withTrailingSlash(getPageRouteSlug(page) || filename);
}
function postUrl(post: any) { return withTrailingSlash(getBlogPermalink(post)); }
function isHiddenPage(page: any) {
  const filename = page?._sys?.filename || '';
  const url = pageUrl(page);
  return Boolean(page?.draft || page?.seo?.noindex || filename === '404' || filename === 'sitemap' || url === '/sitemap/');
}
function isHiddenPost(post: any) { return Boolean(post?.draft || post?.seo?.noindex); }

type SitemapLink = { title: string; url: string };
type SitemapPostLink = SitemapLink & { date: Date | null };

const sitemapPageOrder = ['/', '/about/', '/our-team/', '/contact/', '/blog/', '/write-for-us/'];
const pageLinks: SitemapLink[] = (pages as any[])
  .filter((page: any) => !isHiddenPage(page))
  .map((page: any): SitemapLink => ({
    title: cleanTitle(page.title || page.seoTitle || page.seo?.metaTitle, page?._sys?.filename || content.fallbackPageTitle),
    url: pageUrl(page),
  }))
  .filter((item: SitemapLink) => sitemapPageOrder.includes(item.url))
  .sort((a: SitemapLink, b: SitemapLink) => sitemapPageOrder.indexOf(a.url) - sitemapPageOrder.indexOf(b.url));
const postLinks: SitemapPostLink[] = (posts as any[])
  .filter((post: any) => !isHiddenPost(post))
  .map((post: any): SitemapPostLink => ({
    title: cleanTitle(post.title || post.seo?.metaTitle, post?._sys?.filename || content.fallbackPostTitle),
    url: postUrl(post),
    date: post.pubDate ? new Date(post.pubDate) : null,
  }))
  .sort((a: SitemapPostLink, b: SitemapPostLink) => Number(b.date || 0) - Number(a.date || 0))
  .slice(0, 4);
---

<Base title={title} description={description} ogTitle={title} ogDescription={description} canonicalUrl="/sitemap/">
  <main class="nx-system-sitemap" aria-labelledby="sitemap-title">
    <div class="nx-shell nx-system-sitemap__inner">
      <h1 id="sitemap-title">{content.heading}</h1>
      <div class="nx-system-sitemap__grid">
        <section aria-labelledby="sitemap-pages-title">
          <h2 id="sitemap-pages-title">{content.pagesHeading}</h2>
          {pageLinks.length > 0 ? (
            <ul>{pageLinks.map((item: SitemapLink) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
          ) : <p>{content.emptyPagesText}</p>}
        </section>
        <section aria-labelledby="sitemap-posts-title">
          <h2 id="sitemap-posts-title">{content.postsHeading}</h2>
          {postLinks.length > 0 ? (
            <ul>{postLinks.map((item: SitemapPostLink) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
          ) : <p>{content.emptyPostsText}</p>}
        </section>
      </div>
    </div>
    <CTA />
  </main>
</Base>
