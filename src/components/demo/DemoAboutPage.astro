---
import { tinaField } from '@tinacms/astro/tina-field';
import CTA from '../../templates/CTA.astro';

const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero;
const purpose = block?.purpose;
const coverage = block?.coverage;
const values = block?.standardsSection;
const publishing = block?.independence;
const readers = block?.newsroom;
const coverageItems = Array.isArray(coverage?.items) ? coverage.items : [];
const valueItems = Array.isArray(values?.items) ? values.items : [];
---

<main class="nx-info nx-info--about">
  <section class="nx-info-hero">
    <div class="nx-shell nx-info-hero__inner">
      <nav class="nx-crumbs" aria-label="Breadcrumb">
        <a href="/" data-tina-field={hero ? tinaField(hero, 'breadcrumbLabel') : undefined}>{hero?.breadcrumbLabel}</a>
        <span aria-hidden="true">/</span>
        <span data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{hero?.eyebrow}</span>
      </nav>
      <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{hero?.headline}</h1>
      <p data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{hero?.lede}</p>
    </div>
  </section>

  <section class="nx-info-section nx-info-split">
    <div class="nx-shell nx-info-split__grid">
      <header>
        <p class="nx-info-kicker" data-tina-field={purpose ? tinaField(purpose, 'eyebrow') : undefined}>{purpose?.eyebrow}</p>
        <h2 data-tina-field={purpose ? tinaField(purpose, 'title') : undefined}>{purpose?.title}</h2>
      </header>
      <div class="nx-info-copy">
        <p data-tina-field={purpose ? tinaField(purpose, 'paragraphOne') : undefined}>{purpose?.paragraphOne}</p>
        <p data-tina-field={purpose ? tinaField(purpose, 'paragraphTwo') : undefined}>{purpose?.paragraphTwo}</p>
      </div>
    </div>
  </section>

  <section class="nx-info-section nx-coverage">
    <div class="nx-shell">
      <div class="nx-info-split__grid">
        <header>
          <p class="nx-info-kicker" data-tina-field={coverage ? tinaField(coverage, 'eyebrow') : undefined}>{coverage?.eyebrow}</p>
          <h2 data-tina-field={coverage ? tinaField(coverage, 'title') : undefined}>{coverage?.title}</h2>
        </header>
        <div class="nx-info-copy">
          <p data-tina-field={coverage ? tinaField(coverage, 'intro') : undefined}>{coverage?.intro}</p>
          <p data-tina-field={coverage ? tinaField(coverage, 'paragraphTwo') : undefined}>{coverage?.paragraphTwo}</p>
        </div>
      </div>
      <div class="nx-coverage__links">
        {coverageItems.map((item: any) => (
          <a href={item.link}>
            <span data-tina-field={tinaField(item, 'title')}>{item.title}</span>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="nx-info-section nx-values">
    <div class="nx-shell">
      <p class="nx-info-kicker" data-tina-field={values ? tinaField(values, 'eyebrow') : undefined}>{values?.eyebrow}</p>
      <h2 data-tina-field={values ? tinaField(values, 'title') : undefined}>{values?.title}</h2>
      <div class="nx-values__grid">
        {valueItems.map((item: any) => (
          <article>
            <b data-tina-field={tinaField(item, 'number')}>{item.number}</b>
            <h3 data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
            <p data-tina-field={tinaField(item, 'text')}>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="nx-values__note" data-tina-field={values ? tinaField(values, 'intro') : undefined}>{values?.intro}</p>
    </div>
  </section>

  <section class="nx-info-section nx-publishing">
    <div class="nx-shell nx-info-split__grid">
      <header>
        <p class="nx-info-kicker" data-tina-field={publishing ? tinaField(publishing, 'eyebrow') : undefined}>{publishing?.eyebrow}</p>
        <h2 data-tina-field={publishing ? tinaField(publishing, 'title') : undefined}>{publishing?.title}</h2>
      </header>
      <div class="nx-info-copy">
        <p data-tina-field={publishing ? tinaField(publishing, 'paragraphOne') : undefined}>{publishing?.paragraphOne}</p>
        <p data-tina-field={publishing ? tinaField(publishing, 'paragraphTwo') : undefined}>{publishing?.paragraphTwo}</p>
      </div>
    </div>
  </section>

  <section class="nx-info-section nx-readers">
    <div class="nx-shell nx-info-split__grid">
      <header>
        <p class="nx-info-kicker" data-tina-field={readers ? tinaField(readers, 'eyebrow') : undefined}>{readers?.eyebrow}</p>
        <h2 data-tina-field={readers ? tinaField(readers, 'title') : undefined}>{readers?.title}</h2>
      </header>
      <div class="nx-info-copy">
        <p data-tina-field={readers ? tinaField(readers, 'intro') : undefined}>{readers?.intro}</p>
        <p data-tina-field={readers ? tinaField(readers, 'paragraphTwo') : undefined}>{readers?.paragraphTwo}</p>
      </div>
    </div>
  </section>

  <CTA />
</main>

<style>
  .nx-info{color:#0f1e33;background:#fff}.nx-info :global(h1),.nx-info :global(h2),.nx-info :global(h3),.nx-info :global(p){margin-top:0}.nx-info-hero{background:#0f1e33;color:#fff}.nx-info-hero__inner{padding-top:clamp(56px,8vw,112px);padding-bottom:clamp(48px,6vw,88px)}.nx-crumbs{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;color:#ffffffb3}.nx-crumbs a{color:#ffffffb3}.nx-info-hero h1{max-width:1120px;margin:clamp(26px,4vw,48px) 0 24px;font-size:clamp(52px,9vw,132px);font-weight:900;font-stretch:72%;line-height:.86;letter-spacing:-.035em;text-transform:uppercase}.nx-info-hero p{max-width:870px;margin-bottom:0;font-size:clamp(18px,2vw,25px);line-height:1.55;color:#ffffffd9}.nx-info-section{padding:clamp(56px,8vw,112px) 0}.nx-info-split__grid{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(360px,1.18fr);gap:clamp(40px,8vw,128px);align-items:start}.nx-info-kicker{margin-bottom:18px;color:#0b7bdb;font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.nx-info h2{margin-bottom:0;font-size:clamp(42px,5.8vw,82px);font-weight:900;font-stretch:72%;line-height:.92;letter-spacing:-.025em;text-transform:uppercase}.nx-info-copy p{margin-bottom:24px;font-size:clamp(17px,1.55vw,20px);line-height:1.75}.nx-info-copy p:last-child{margin-bottom:0}.nx-coverage{background:#eaf4fd}.nx-coverage__links{display:grid;grid-template-columns:repeat(3,1fr);margin-top:clamp(42px,6vw,80px);border-top:2px solid #0f1e33}.nx-coverage__links a{display:flex;justify-content:space-between;gap:20px;padding:22px 18px;border-right:1px solid #aebdcd;border-bottom:1px solid #aebdcd;color:#0f1e33;font-size:18px;font-weight:800;text-transform:uppercase}.nx-coverage__links a:nth-child(3n){border-right:0}.nx-coverage__links i{color:#0b7bdb;font-size:24px;font-style:normal}.nx-values h2{margin:12px 0 clamp(36px,5vw,64px)}.nx-values__grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:2px solid #0f1e33}.nx-values article{min-width:0;padding:24px 22px 12px;border-right:1px solid #ccd3dc}.nx-values article:last-child{border-right:0}.nx-values b{color:#0b7bdb;font-size:13px}.nx-values h3{margin:34px 0 8px;font-size:clamp(18px,2vw,25px);line-height:1.1;text-transform:uppercase}.nx-values article p{margin-bottom:0;color:#5b6b82;font-size:15px;line-height:1.6}.nx-values__note{max-width:780px;margin:42px 0 0;color:#5b6b82}.nx-publishing{background:#0f1e33;color:#fff}.nx-publishing .nx-info-kicker{color:#7ebff4}.nx-publishing .nx-info-copy{color:#ffffffd9}.nx-readers{background:#fff}
  @media(max-width:760px){.nx-info-hero__inner{padding-top:52px;padding-bottom:54px}.nx-info-hero h1{font-size:clamp(48px,15vw,68px);margin-top:30px}.nx-info-hero p{font-size:17px}.nx-info-split__grid{grid-template-columns:1fr;gap:30px}.nx-info h2{font-size:clamp(40px,12vw,54px)}.nx-coverage__links{grid-template-columns:1fr}.nx-coverage__links a,.nx-coverage__links a:nth-child(3n){border-right:0}.nx-values__grid{grid-template-columns:1fr}.nx-values article{display:grid;grid-template-columns:38px 120px 1fr;gap:12px;padding:20px 0;border-right:0;border-bottom:1px solid #ccd3dc}.nx-values h3{margin:0}.nx-values article p{margin:0}.nx-values__note{margin-top:30px}}
</style>
