---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import CTA from '../../templates/CTA.astro';

const { data } = Astro.props;
const contentBlock = Array.isArray(data?.blocks)
  ? data.blocks.find((block: any) => block?.__typename === 'PageBlocksContent' || block?._template === 'content')
  : null;
const body = contentBlock?.body;
const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;')
  .replaceAll("'", '&#039;');
const inlineMarkdown = (value: string) => escapeHtml(value)
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1">$1</a>')
  .replace(/(^|\s)([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})/gi, '$1<a href="mailto:$2">$2</a>');
const markdownHtml = typeof body === 'string'
  ? body.trim().split(/\n\s*\n/).map((chunk: string) => {
      const text = chunk.trim();
      if (text.startsWith('## ')) return `<h2>${inlineMarkdown(text.slice(3))}</h2>`;
      if (text.startsWith('### ')) return `<h3>${inlineMarkdown(text.slice(4))}</h3>`;
      return `<p>${inlineMarkdown(text.replace(/\n/g, ' '))}</p>`;
    }).join('')
  : '';
---

<main class="nx-policy">
  <div class="nx-policy__inner nx-shell">
    <h1 data-tina-field={data ? tinaField(data, 'title') : undefined}>{data?.title}</h1>
    <article data-tina-field={contentBlock ? tinaField(contentBlock, 'body') : undefined}>
      {typeof body === 'string' ? <Fragment set:html={markdownHtml} /> : body && <TinaMarkdown content={body} />}
    </article>
  </div>
</main>
<CTA />
