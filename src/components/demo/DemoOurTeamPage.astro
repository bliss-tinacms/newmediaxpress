---
import { tinaField } from '@tinacms/astro/tina-field';
import CTA from '../../templates/CTA.astro';

const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero;
const leadership = block?.leadership;
const seniorStaff = block?.seniorStaff;
const leaders = Array.isArray(leadership?.people) ? leadership.people : [];
const editors = Array.isArray(seniorStaff?.people) ? seniorStaff.people : [];
function highlightedParts(value = '', highlight = '') {
  const start = highlight ? value.toLowerCase().indexOf(highlight.toLowerCase()) : -1;
  return start < 0 ? { before: value, highlight: '', after: '' } : { before: value.slice(0,start), highlight: value.slice(start,start+highlight.length), after: value.slice(start+highlight.length) };
}
const heroTitle = highlightedParts(hero?.headline, hero?.headlineHighlight);
---

<main class="nx-team-page">
  <section class="nx-team-hero">
    <div class="nx-shell nx-team-hero__inner">
      <nav class="nx-team-crumb" aria-label="Breadcrumb"><a href="/" data-tina-field={hero ? tinaField(hero,'breadcrumbLabel') : undefined}>{hero?.breadcrumbLabel}</a><span>/</span><span data-tina-field={hero ? tinaField(hero,'eyebrow') : undefined}>{hero?.eyebrow}</span></nav>
      <h1 data-tina-field={hero ? tinaField(hero,'headline') : undefined}>{heroTitle.before}<em>{heroTitle.highlight}</em>{heroTitle.after}</h1>
      <p data-tina-field={hero ? tinaField(hero,'lede') : undefined}>{hero?.lede}</p>
    </div>
  </section>

  <section class="nx-shell nx-team-leadership">
    <p class="nx-team-kicker" data-tina-field={leadership ? tinaField(leadership,'eyebrow') : undefined}>{leadership?.eyebrow}</p>
    <div class="nx-team-leaders">
      {leaders.map((person:any) => (
        <article>
          <img src={person.image} alt={person.imageAlt || person.name || ''} data-tina-field={tinaField(person,'image')} />
          <div class="nx-team-person__name"><h2 data-tina-field={tinaField(person,'name')}>{person.name}</h2><span data-tina-field={tinaField(person,'location')}>{person.location}</span></div>
          <b data-tina-field={tinaField(person,'role')}>{person.role}</b>
          <p data-tina-field={tinaField(person,'bio')}>{person.bio}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="nx-shell nx-team-editors">
    <p class="nx-team-kicker" data-tina-field={seniorStaff ? tinaField(seniorStaff,'eyebrow') : undefined}>{seniorStaff?.eyebrow}</p>
    <div class="nx-team-editors__grid">
      {editors.map((person:any) => (
        <article>
          <img src={person.image} alt={person.imageAlt || person.name || ''} data-tina-field={tinaField(person,'image')} />
          <div>
            <h3 data-tina-field={tinaField(person,'name')}>{person.name}</h3>
            <div class="nx-team-editor__meta"><b data-tina-field={tinaField(person,'role')}>{person.role}</b><span data-tina-field={tinaField(person,'location')}>{person.location}</span></div>
            <p data-tina-field={tinaField(person,'bio')}>{person.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CTA />
</main>

<style>
  .nx-team-page{background:#fff;color:#0f1e33}.nx-team-page :global(.nx-shell){max-width:1296px}.nx-team-page :global(h1),.nx-team-page :global(h2),.nx-team-page :global(h3),.nx-team-page :global(p){margin-top:0}.nx-team-hero{background:#0f1e33;color:#fff}.nx-team-hero__inner{padding-top:115px;padding-bottom:127px}.nx-team-crumb{display:flex;gap:12px;color:#aeb8c5;font-size:14px;font-weight:600}.nx-team-crumb a{color:#aeb8c5}.nx-team-crumb span:last-child{color:#fff}.nx-team-hero h1{margin:clamp(20px,3vw,32px) 0 0;color:#fff!important;font-size:clamp(48px,8vw,112px);font-weight:900;font-stretch:72%;line-height:.88;letter-spacing:-.03em;text-transform:uppercase}.nx-team-hero h1 em{color:#1fd1d1;font-style:normal}.nx-team-hero p{max-width:1000px;margin:clamp(28px,4vw,48px) 0 0;font-size:clamp(22px,2.4vw,32px);font-weight:700;line-height:1.3;letter-spacing:-.01em}.nx-team-kicker{margin:0 0 34px;color:#0b7bdb;font-size:14px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.nx-team-leadership{padding-top:92px;padding-bottom:96px}.nx-team-leaders{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(30px,4vw,60px)}.nx-team-leaders article img{width:100%;aspect-ratio:500/490;object-fit:cover;border-radius:20px;margin-bottom:25px}.nx-team-person__name{display:flex;justify-content:space-between;align-items:baseline;gap:16px}.nx-team-person__name h2{margin:0;font-size:clamp(38px,4vw,56px);font-weight:900;font-stretch:75%;line-height:.92;letter-spacing:-.015em;text-transform:uppercase}.nx-team-person__name span{flex:none;color:#60708a;font-size:14px;font-weight:600}.nx-team-leaders article>b{display:inline-block;margin-top:17px;border-radius:999px;background:#0b7bdb;padding:8px 15px;color:#fff;font-size:13px;line-height:1.5;letter-spacing:.08em;text-transform:uppercase}.nx-team-leaders article>p{margin:23px 0 0;color:#33415a;font-size:17px;line-height:1.7}.nx-team-editors{padding-bottom:100px}.nx-team-editors__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:70px 68px}.nx-team-editors article{display:grid;grid-template-columns:150px 1fr;gap:24px;align-items:start}.nx-team-editors article>img{width:150px;height:150px;border-radius:50%;object-fit:cover}.nx-team-editors h3{margin:0;font-size:clamp(28px,2.6vw,36px);font-weight:900;font-stretch:75%;line-height:.95;text-transform:uppercase}.nx-team-editor__meta{display:flex;gap:18px;align-items:baseline}.nx-team-editor__meta b{color:#0b7bdb;font-size:14px;letter-spacing:.09em;text-transform:uppercase}.nx-team-editor__meta span{color:#60708a;font-size:14px;font-weight:600}.nx-team-editors article p{margin:18px 0 0;color:#33415a;font-size:18px;line-height:1.68}
  @media(max-width:760px){.nx-team-hero__inner{padding-top:59px;padding-bottom:56px}.nx-team-hero h1{margin:26px 0 27px;font-size:47px;line-height:.9}.nx-team-hero p{font-size:23px;line-height:1.24}.nx-team-leadership{padding-top:57px;padding-bottom:71px}.nx-team-kicker{margin-bottom:31px}.nx-team-leaders{grid-template-columns:1fr;gap:44px}.nx-team-leaders article img{aspect-ratio:358/350;margin-bottom:20px}.nx-team-person__name{align-items:baseline}.nx-team-person__name h2{font-size:35px}.nx-team-person__name span{font-size:14px}.nx-team-leaders article>b{margin-top:16px}.nx-team-leaders article>p{margin-top:22px;font-size:18px;line-height:1.7}.nx-team-editors{padding-bottom:61px}.nx-team-editors__grid{grid-template-columns:1fr;gap:60px}.nx-team-editors article{display:block}.nx-team-editors article>img{width:96px;height:96px;margin-bottom:20px}.nx-team-editors h3{font-size:28px;margin-bottom:10px}.nx-team-editor__meta{gap:17px}.nx-team-editors article p{font-size:18px;line-height:1.7;margin-top:16px}}
</style>
