---
import CTA from '../../templates/CTA.astro';
const { content } = Astro.props;
---

<main class="nx-system-404">
  <section class="nx-system-404__hero">
    <div class="nx-shell nx-system-404__inner">
      <div class="nx-system-404__code">{content.code}</div>
      <h1>{content.heading}</h1>
      <p>{content.message}</p>
      <div><a class="nx-system-404__button" href={content.buttonLink}>{content.buttonText}</a></div>
    </div>
  </section>
  <CTA />
</main>
