---
import { tinaField } from '@tinacms/astro/tina-field';
import CTA from '../../templates/CTA.astro';

const { data = null, config = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const formSection = block?.formSection || {};
const inboxes = block?.inboxes || {};
const requests = block?.requests || {};
const inboxCards = Array.isArray(inboxes?.cards) ? inboxes.cards : [];
const requestCards = Array.isArray(requests?.cards) ? requests.cards : [];
const formAction = config?.contactForm?.formspreeEndpoint || formSection.formAction || '';
const formConfigured = /^https:\/\/formspree\.io\/f\/[A-Za-z0-9_-]+$/.test(formAction);
const linkedRequestText = (value = '') => {
  const escaped = value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
  return escaped
    .replace(/([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})/gi, '<a href="mailto:$1">$1</a>')
    .replace(/\b(DMCA Policy)\b/g, '<a href="/dmca-policy/">$1</a>');
};
---

<main class="nx-contact">
  <header class="nx-contact__hero">
    <div class="nx-shell nx-contact__hero-inner">
      <div class="nx-contact__crumb">
        <a href={hero.breadcrumbHomeLink} data-tina-field={tinaField(hero, 'breadcrumbHome')}>{hero.breadcrumbHome}</a>
        <span data-tina-field={tinaField(hero, 'breadcrumbSeparator')}>{hero.breadcrumbSeparator}</span>
        <span data-tina-field={tinaField(hero, 'breadcrumbCurrent')}>{hero.breadcrumbCurrent}</span>
      </div>
      <h1>
        <span data-tina-field={tinaField(hero, 'headlineLead')}>{hero.headlineLead}</span>{' '}
        <span data-tina-field={tinaField(hero, 'headlineAccent')}>{hero.headlineAccent}</span>
      </h1>
      <p data-tina-field={tinaField(hero, 'lede')}>{hero.lede}</p>
    </div>
  </header>

  <section class="nx-contact__main nx-shell">
    <div class="nx-contact__form-column">
      <p class="nx-contact__kicker" data-tina-field={tinaField(formSection, 'eyebrow')}>{formSection.eyebrow}</p>
      <h2 data-tina-field={tinaField(formSection, 'title')}>{formSection.title}</h2>
      <form method="POST" action={formConfigured ? formAction : undefined}>
        <input type="hidden" name="_subject" value={formSection.subject || config?.contactForm?.subject} />
        <label>
          <span data-tina-field={tinaField(formSection, 'nameLabel')}>{formSection.nameLabel}</span>
          <input required name="name" type="text" autocomplete="name" />
        </label>
        <label>
          <span data-tina-field={tinaField(formSection, 'phoneLabel')}>{formSection.phoneLabel}</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label class="nx-contact__wide">
          <span data-tina-field={tinaField(formSection, 'emailLabel')}>{formSection.emailLabel}</span>
          <input required name="email" type="email" autocomplete="email" />
        </label>
        <label class="nx-contact__wide">
          <span data-tina-field={tinaField(formSection, 'messageLabel')}>{formSection.messageLabel}</span>
          <textarea required name="message" rows="6"></textarea>
        </label>
        <div class="nx-contact__form-footer">
          <span data-tina-field={tinaField(formSection, 'note')}>{formSection.note}</span>
          <button type="submit" disabled={!formConfigured} aria-disabled={!formConfigured} data-tina-field={tinaField(formSection, 'buttonText')}>{formSection.buttonText}</button>
        </div>
      </form>
    </div>

    <div class="nx-contact__inboxes">
      {inboxCards.map((card: any, index: number) => (
        <article class:list={['nx-contact__inbox', { 'nx-contact__inbox--dark': index === 0 }]}>
          <p class="nx-contact__kicker" data-tina-field={tinaField(card, 'title')}>{card.title}</p>
          <a href={`mailto:${card.email}`} data-tina-field={tinaField(card, 'email')}>{card.email}</a>
          <p data-tina-field={tinaField(card, 'description')}>{card.description}</p>
          {card.note && <p class="nx-contact__note" data-tina-field={tinaField(card, 'note')}>{card.note}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="nx-contact__requests nx-shell">
    <div class="nx-contact__request-grid">
      {requestCards.map((card: any) => (
        <article>
          <span data-tina-field={tinaField(card, 'number')}>{card.number}</span>
          <h3 data-tina-field={tinaField(card, 'title')}>{card.title}</h3>
          <p data-tina-field={tinaField(card, 'text')} set:html={linkedRequestText(card.text)} />
        </article>
      ))}
    </div>
  </section>
</main>
<CTA />
