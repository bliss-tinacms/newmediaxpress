---
import { tinaField } from "tinacms/dist/react";
import CTA from "../../templates/CTA.astro";
import { getBlogPermalink } from '../../lib/permalinks';
interface Props { archiveTitle: string; author?: any; editData?: any; posts?: any[]; currentPage?: number; totalPages?: number; basePath?: string; }
const { archiveTitle, author = {}, editData, posts = [], currentPage = 1, totalPages = 1, basePath = "" } = Astro.props;
const href = (p:any) => { const url = getBlogPermalink(p); return url.endsWith('/') ? url : url + '/'; };
const formatDate = (v:any) => v ? new Date(v).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}) : "";
const categoryName = (p:any) => {
  const category = Array.isArray(p?.categories) ? p.categories[0] : p?.category;
  if (category && typeof category === "object") return category.name || category.title || "";
  return String(category || "").split("/").pop()?.replace(/\.json$/i,"").replace(/-/g," ") || "";
};
const lead = posts[0]; const rest = posts.slice(1);
const pageUrl = (n:number) => n <= 1 ? `${basePath}/` : `${basePath}/page/${n}/`;
---
<main class="nx-author">
  <section class="nx-author-hero"><div class="nx-shell nx-author-hero__inner">
    {author?.avatar && <img src={author.avatar} alt={archiveTitle} data-tina-field={editData ? tinaField(editData,"avatar") : undefined}/>}<div><span>{author?.role}</span><h1 data-tina-field={editData ? tinaField(editData,"name") : undefined}>{archiveTitle}</h1>{author?.bio && <p data-tina-field={editData ? tinaField(editData,"bio") : undefined}>{author.bio}</p>}</div>
  </div></section>
  {lead && <section class="nx-shell nx-lead-story"><a href={href(lead)}><img src={lead.heroImage} alt={lead.heroImageAlt || ""}/><span class="nx-lead-story__copy"><small>Latest</small><strong>{lead.title}</strong><em>{lead.description}</em><span class="nx-byline"><b>{categoryName(lead)}</b><i>·</i>{formatDate(lead.pubDate)}<i>·</i>{lead.readingTime}</span></span></a></section>}
  {rest.length > 0 && <section class="nx-shell nx-archive-grid">{rest.map((post:any)=><a class="nx-archive-card" href={href(post)}><img src={post.heroImage} alt={post.heroImageAlt || ""}/><strong>{post.title}</strong><p>{post.description}</p><span class="nx-archive-card__meta"><b class="nx-archive-card__taxonomy">{categoryName(post)}</b><span>{formatDate(post.pubDate)}</span></span></a>)}</section>}
  {totalPages > 1 && <nav class="nx-pagination" aria-label="Pagination">{Array.from({length:totalPages},(_,i)=>i+1).map((page)=><a class:list={["nx-pagination__page",{active:page===currentPage}]} aria-current={page===currentPage?"page":undefined} href={pageUrl(page)}>{page}</a>)}{currentPage < totalPages && <a class="nx-pagination__next" href={pageUrl(currentPage+1)}>Next →</a>}</nav>}
  <CTA />
</main>
